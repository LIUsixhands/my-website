# 複製成 .env 後填入真實值。.env 已被 .gitignore 擋掉，不會進版控。
# config.py 會自動讀這個檔案；已存在的環境變數優先。

# 永豐金證券 Shioaji API（官網申請，需先簽署 API 服務條款與風險預告書）
SHIOAJI_API_KEY=
SHIOAJI_SECRET_KEY=

# 1 = 模擬模式，0 = 真錢。前三個月不要改成 0。
SHIOAJI_SIMULATION=1

# 電子憑證：只有真錢模式（SIMULATION=0）需要。
# 帳務查詢要憑證，而風控的日虧上限與連敗停手都靠帳務 ——
# 沒有憑證就查不到損益，閘門會直接關閘停手。
# 憑證從永豐電腦版下單軟體 e-Leader 下載，是一個 .pfx 檔。
SHIOAJI_CA_PATH=
SHIOAJI_CA_PASSWD=
SHIOAJI_PERSON_ID=

# Telegram 推播（Line Notify 已停止服務）
# BOT_TOKEN 向 @BotFather 申請；CHAT_ID 可向 @userinfobot 查詢
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
