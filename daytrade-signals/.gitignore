# 金鑰
.env

# 當日產出：每天都會變，而且是個人帳務資料
state.json
watchlist.json
outcomes.csv
# candidates 這兩份和 outcomes.csv 是同一類東西（同樣的欄位、同樣的個人交易
# 紀錄），卻漏在這張清單外面 —— 新增 candidates.csv 的那次忘了同步更新。
# 漏掉的後果不是「檔案多了一個」，是個人損益紀錄會跟著 commit 上 GitHub。
candidates.csv
candidates_outcomes.csv
# 08:45 盤前首選的結局（同一類個人交易紀錄）
picks.csv
# 首選之後 5 天的走勢（followup.py）：同一類個人紀錄
pick_followup.csv

# 交易日誌含個人損益與持股，不進版控。
# 要給 Claude 做跨日稽核時，直接把本機的 journal/ 目錄丟給它。
journal/*.md
# 當日候選池存檔（screener.py 自己寫的）。裡面是你每天在盯哪些股票，
# 跟 watchlist.json 是同一份東西，只是多了日期 —— 排除理由一樣。
journal/watchlist-*.json
# 開盤前試撮存檔（preopen.py）：一樣看得出你每天盯哪些股票。
journal/preopen-*.json
# whatif.py 的分鐘 K 快取：體積大，而且看得出你每天盯哪些股票。
journal/kbars/

__pycache__/
*.pyc

# morning.bat 的執行紀錄（排程跑失敗時唯一的線索，但不進版控）
logs/
